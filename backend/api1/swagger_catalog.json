{
  "openapi": "3.0.0",
  "info": {
    "title": "Service_Catalog API",
    "description": "Microserviço responsável pela pesquisa e consulta do acervo global de livros.",
    "version": "1.1.0"
  },
  "paths": {
    "/searchBooks": {
      "get": {
        "summary": "Pesquisa livros por título ou autor",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Termo de pesquisa",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de volumes encontrada",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "type": "object" } }
              }
            }
          }
        }
      }
    }
  }
}